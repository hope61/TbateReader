# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env and update the values as needed
# cp .env.example .env

# =============================================================================
# Required Environment Variables
# =============================================================================

# Environment: development, production
# Controls HTTPS redirects and security headers
ENVIRONMENT=development

# Enable/disable API documentation (Swagger UI)
# Set to "true" to enable /docs endpoint
ENABLE_DOCS=true

# CORS origins (comma-separated list)
# For development: http://localhost:3000,http://frontend:80
# For production: https://yourdomain.com
# For Cloudflare tunnel: *
CORS_ORIGINS=http://localhost:3000,http://frontend:80

# =============================================================================
# Optional Environment Variables
# =============================================================================

# Domain for production (used in TrustedHostMiddleware)
# Only used when ENVIRONMENT=production
DOMAIN=localhost

# API base URL for image URLs
# If not set, will auto-detect from request
# Example: http://localhost:8000
API_BASE_URL=

# =============================================================================
# Example Configurations
# =============================================================================

# Development (local):
# ENVIRONMENT=development
# CORS_ORIGINS=http://localhost:3000,http://frontend:80
# ENABLE_DOCS=true

# Production (Cloudflare tunnel):
# ENVIRONMENT=production
# CORS_ORIGINS=*
# ENABLE_DOCS=true
# DOMAIN=yourdomain.com
